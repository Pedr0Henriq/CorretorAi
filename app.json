{
  "expo": {
    "name": "corretorAi",
    "slug": "corretorAi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/corretor.png",
    "scheme": "redacao",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/corretor.png",
      "resizeMode": "cover",
      "backgroundColor": "#dfd7f8"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/corretor.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
